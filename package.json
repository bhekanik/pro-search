{
	"name": "pro-search",
	"version": "0.0.1",
	"author": "Bhekani Khumalo",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"dev:https": "dev --https",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --ignore-path .gitignore --write . && eslint src/",
		"format": "prettier --ignore-path .gitignore --write .",
		"cy:open-ct": "cypress open-ct",
		"cy:run-ct": "cypress run-ct",
		"prepare": "husky install"
	},
	"dependencies": {
		"@sentry/browser": "^7.80.0",
		"@sentry/tracing": "^7.77.0",
		"@splitsoftware/splitio": "^10.23.1",
		"@supabase/supabase-js": "^2.38.4",
		"autoprefixer": "^10.4.16",
		"case": "^1.6.3",
		"daisyui": "^3.9.4",
		"fast-fuzzy": "^1.12.0",
		"logrocket": "^6.0.2",
		"qrcode": "^1.5.3",
		"supabase-ui-svelte": "^0.1.1",
		"theme-change": "^2.5.0"
	},
	"devDependencies": {
		"@cypress/vite-dev-server": "^5.0.6",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.30.1",
		"@sveltejs/adapter-auto": "^6.0.1",
		"@sveltejs/adapter-vercel": "^5.7.2",
		"@sveltejs/kit": "^2.22.5",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/typography": "^0.5.10",
		"@testing-library/cypress": "^10.0.1",
		"@types/node": "^20.9.0",
		"@types/qrcode": "^1.5.5",
		"@typescript-eslint/eslint-plugin": "^8.36.0",
		"@typescript-eslint/parser": "^8.36.0",
		"autoprefixer": "^10.4.16",
		"cypress": "^13.5.0",
		"cypress-svelte-unit-test": "^3.3.4",
		"eslint": "^9.30.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^3.10.1",
		"globals": "^16.3.0",
		"husky": "^8.0.3",
		"lint-staged": "^15.1.0",
		"postcss": "^8.4.31",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.35.6",
		"svelte-check": "^4.2.2",
		"svelte-eslint-parser": "^1.2.0",
		"svelte-feather-icons": "^4.0.1",
		"svelte-preprocess": "^6.0.3",
		"tailwindcss": "^3.3.5",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2",
		"typescript-eslint": "^8.36.0",
		"vite": "^7.0.4"
	},
	"type": "module",
	"lint-staged": {
		"src/**/*.{js,ts,svelte}": "prettier --write . && eslint src/",
		"src/**/*.{ts,svelte}": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
		"functions/**/*.{js,ts}": "prettier --write . && eslint functions/",
		"src/**/*.{js,css,md,svelte,ts}": "npm run format"
	}
}
